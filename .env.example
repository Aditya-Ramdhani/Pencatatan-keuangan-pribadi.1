# Prisma Database connection URL
# Default local zero-setup SQLite database:
DATABASE_URL="file:./dev.db"

# PostgreSQL example (Neon, Supabase, etc.):
# DATABASE_URL="postgresql://user:password@ep-example.neon.tech/fintrack?sslmode=require"

# JWT Secret for Session & Cookie Authentication
JWT_SECRET="your-super-secret-jwt-key"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
